# Copia este archivo a `.env.local` (o `.env` en el servidor) y llena los
# valores reales. NUNCA subas los archivos con valores reales al repositorio.

# --- Autenticación / base de datos ---
# Secreto para firmar las sesiones (mínimo 16 caracteres, usa uno aleatorio):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Ruta del archivo SQLite (por defecto ./data/app.db).
DATABASE_PATH=./data/app.db

# --- Administrador inicial (solo para `npm run seed:admin`) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador

# --- Credenciales de los web services de cada aseguradora ---
# Quálitas
QUALITAS_WS_URL=
QUALITAS_WS_USER=
QUALITAS_WS_PASS=

# Banorte Seguros
BANORTE_WS_URL=
BANORTE_WS_USER=
BANORTE_WS_PASS=

# HDI Seguros
HDI_WS_URL=
HDI_WS_USER=
HDI_WS_PASS=

# Zurich
ZURICH_WS_URL=
ZURICH_WS_USER=
ZURICH_WS_PASS=

# GNP Seguros
GNP_WS_URL=
GNP_WS_USER=
GNP_WS_PASS=

# Seguros El Potosí
EL_POTOSI_WS_URL=
EL_POTOSI_WS_USER=
EL_POTOSI_WS_PASS=

# Afirme Seguros
AFIRME_WS_URL=
AFIRME_WS_USER=
AFIRME_WS_PASS=

# Seguros Atlas
ATLAS_WS_URL=
ATLAS_WS_USER=
ATLAS_WS_PASS=
