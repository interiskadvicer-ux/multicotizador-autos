# Copia este archivo a `.env.local` (o `.env` en el servidor) y llena los
# valores reales. NUNCA subas los archivos con valores reales al repositorio.

# --- Autenticación / base de datos ---
# Secreto para firmar las sesiones (mínimo 16 caracteres, usa uno aleatorio):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Ruta del archivo SQLite (por defecto ./data/app.db).
DATABASE_PATH=./data/app.db

# --- Administrador inicial (solo para `npm run seed:admin`) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador

# --- Credenciales de los web services de cada aseguradora ---
# Quálitas (integración real de cotización — WS obtenerNuevaEmision)
# Ambiente: "pruebas" (QA) o "produccion". Por defecto: pruebas.
QUALITAS_AMBIENTE=pruebas
# Datos del negocio (según la matriz entregada por Quálitas).
QUALITAS_NEGOCIO=08849
QUALITAS_AGENTE=0080245
# Descuento comercial máximo autorizado (%) para el negocio.
QUALITAS_DESCUENTO_DEFAULT=45
# Poner en "false" para forzar cotización simulada de Quálitas.
QUALITAS_COTIZACION_REAL=true
# Opcional: sobreescribe el endpoint del WS de cotización/emisión.
QUALITAS_WS_URL=
# --- Catálogo de vehículos de Quálitas (WSTarifas / QBCenter) ---
# Usuario y tarifa que entrega Quálitas para consultar claves de vehículos.
# Para el negocio 08849 Quálitas autorizó el usuario/tarifa de línea "LINEA".
QUALITAS_QBC_USUARIO=LINEA
QUALITAS_QBC_TARIFA=LINEA
QUALITAS_WS_TARIFAS_URL=

# --- Banorte Seguros (Autos Individual, servicios REST) ---
# "preproduccion" (oficina de pruebas) o "produccion".
BANORTE_AMBIENTE=preproduccion
# Usuario y contraseña del servicio (Basic Auth, usuario de Weblogic).
BANORTE_WS_USER=
BANORTE_WS_PASS=
# Usuario de Espacio y su oficina. Viajan en los headers `usuario` y
# `numOficina`; deben corresponder entre sí o el servicio los rechaza.
BANORTE_USUARIO_ESPACIO=
BANORTE_NUM_OFICINA=
# Clave del intermediario al que se acredita la cotización.
BANORTE_INTERMEDIARIO=
# Producto y categoría de Autos, tal como los devuelve el catálogo de productos.
BANORTE_PRODUCTO=SEGURO DE AUTOMÓVILES RESIDENTES
BANORTE_CATEGORIA=AUTOS RESIDENTES
# Tope de descuento discrecional (%) autorizado para el negocio.
BANORTE_DESCUENTO_DEFAULT=30
# Pon "false" para forzar la cotización simulada de Banorte.
BANORTE_COTIZACION_REAL=true
BANORTE_BASE_URL=

# HDI Seguros
HDI_WS_URL=
HDI_WS_USER=
HDI_WS_PASS=

# Zurich
ZURICH_WS_URL=
ZURICH_WS_USER=
ZURICH_WS_PASS=

# GNP Seguros
GNP_WS_URL=
GNP_WS_USER=
GNP_WS_PASS=

# Seguros El Potosí
EL_POTOSI_WS_URL=
EL_POTOSI_WS_USER=
EL_POTOSI_WS_PASS=

# --- Afirme Seguros (Midas Autos: token REST + servicios SOAP) ---
# Usuario y contraseña del agente para rest/auth/login.action.
AFIRME_WS_USER=
AFIRME_WS_PASS=
# Negocio, producto y tipo de póliza asignados por Afirme al agente.
AFIRME_NEGOCIO=4781
AFIRME_PRODUCTO=5432
AFIRME_TIPO_POLIZA=5556
# Líneas de negocio donde se busca el vehículo (31532 automóviles, 31533 pick ups).
AFIRME_LINEAS_NEGOCIO=31532,31533
# Tope de descuento (%) que Afirme permite al agente (getDescuentoByNegocioAgenteCp).
AFIRME_DESCUENTO_DEFAULT=25
# Pon "false" para forzar la cotización simulada de Afirme.
AFIRME_COTIZACION_REAL=true
# Opcional: sobreescribe el host (por defecto https://midas2.afirmeseguros.com).
AFIRME_BASE_URL=

# Seguros Atlas
ATLAS_WS_URL=
ATLAS_WS_USER=
ATLAS_WS_PASS=
